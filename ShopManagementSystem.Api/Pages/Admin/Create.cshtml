@page
@model ShopManagementSystem.Api.Pages.Admin.CreateModel
@{
    ViewData["title"] = "Create Product";
}

<h1>Create Product</h1>
<hr />
<form method="post" enctype="multipart/form-data">
    <div class="form-group">
        <label asp-for="CreateProduct.Name"></label>
        <input class="form-control" asp-for="CreateProduct.Name" />
    </div>
    <div class="form-group">
        <label asp-for="CreateProduct.Description"></label>
        <textarea class="form-control" asp-for="CreateProduct.Description"></textarea>
    </div>
    <div class="form-group">
        <label asp-for="CreateProduct.Price"></label>
            <input class="form-control" asp-for="CreateProduct.Price" />
    </div>
    <div class="form-group">
        <label>Categoris</label>
        <select class="form-control"
                asp-for="CreateProduct.CategoryId"
                asp-items="@(new SelectList(Model.Categories, "CategoryId", "Name"))">
        </select>
    </div>
    <div class="form-group">
        <label asp-for="CreateProduct.QuantityInStock"></label>
        <input class="form-control" asp-for="CreateProduct.QuantityInStock" />
    </div>
    <div class="form-group">
        <label asp-for="CreateProduct.Picture"></label>
        <input class="form-control-file" asp-for="CreateProduct.Picture" />
    </div>
    <div class="text-danger" asp-validation-summary="All"></div>
    <div class="form-group">
        <input class="btn btn-success" type="submit" value="Create" />
    </div>
</form>