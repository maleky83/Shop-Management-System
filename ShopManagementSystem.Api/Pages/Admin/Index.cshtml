@page
@using ShopManagementSystem.Application.DTOs.Product
@model ShopManagementSystem.Api.Pages.Admin.IndexModel
@{
    ViewData["title"] = "Index";
}

<h1>Products</h1>
<p>
    <a class="btn btn-outline-success"
       asp-page="Create">
        Add Product
    </a>
</p>
<table>
    <thead>
        <tr>
            <th>Picture</th>
            <th>Name</th>
            <th>Price</th>
            <th>Commands</th>
        </tr>
    </thead>
    <tbody>
        @foreach (ProductViewModel item in Model.Products)
        {
            <tr>
                <td>
                    <img class="card-img-top img-thumbnail"
                         style="max-width:200px;border:1px solid gray;padding:3px;"
                         src="~/images/@(item.PictureName)" />
                </td>
                <td>@item.Name</td>
                <td>@item.Price</td>
                <td>
                    <a asp-route-id="@item.ProductId"
                       asp-page="Edit">
                        Edit
                    </a>
                    <a asp-route-id="@item.ProductId"
                       asp-page="Delete">
                        Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>