@page
@model ShopManagementSystem.Api.Pages.Admin.ManageUser.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-page="Upsert">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Users[0].Name)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Users[0].RegisterDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Users[0].IsAdmin)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Users)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Name)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.RegisterDate)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.IsAdmin)
                </td>
                <td>
                    <a asp-page="./Upsert" asp-route-userId="@item.UserId">Edit</a> |
                    <a asp-page="./Details" asp-route-userId="@item.UserId">Details</a> |
                    <a asp-page="./Delete" asp-route-userId="@item.UserId">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
