@page
@model ShopManagementSystem.Api.Pages.Admin.ManageUser.EditModel

@{
    ViewData["Title"] = "Edit";
}

<h1>Upsert</h1>

<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <input type="hidden" asp-for="model.UserId" />
            <div class="form-group">
                <label asp-for="model.Name" class="control-label"></label>
                <input asp-for="model.Name" class="form-control" />
            </div>
            <div class="form-group">
                <label asp-for="model.NewPassword" class="control-label"></label>
                <input asp-for="model.NewPassword" class="form-control" />
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="model.IsAdmin" /> @Html.DisplayNameFor(model => model.model.IsAdmin)
                </label>
            </div>
            <div asp-validation-summary="All" class="text-danger"></div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Back to List</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
