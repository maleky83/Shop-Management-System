@page
@model ShopManagementSystem.Api.Pages.Admin.AddModel
@{
    ViewData["title"] = "Add Product";
}

<h1>افزودن کالا</h1>
<hr />
<form method="post" enctype="multipart/form-data">
    <div class="form-group">
        <label asp-for="Product.Name"></label>
        <input class="form-control" asp-for="Product.Name" />
    </div>
    <div class="form-group">
        <label asp-for="Product.Description"></label>
        <textarea class="form-control" asp-for="Product.Description"></textarea>
    </div>
    <div class="form-group">
        <label asp-for="Product.Price"></label>
        <input class="form-control" asp-for="Product.Price" />
    </div>
    <div class="form-group">
        <label>دسته بندی</label>
        <select class="form-control"
                asp-for="Product.CategoriIds"
                asp-items="@(new MultiSelectList(Model.Product.Categories, "Id", "Name"))">
        </select>
    </div>
    <div class="form-group">
        <label asp-for="Product.QuantityInStock"></label>
        <input class="form-control" asp-for="Product.QuantityInStock" />
    </div>
    <div class="form-group">
        <label asp-for="Product.Picture"></label>
        <input class="form-control-file" asp-for="Product.Picture" />
    </div>
    <div class="text-danger" asp-validation-summary="All"></div>
    <div class="form-group">
        <input class="btn btn-success" type="submit" value="ثبت" />
    </div>
</form>